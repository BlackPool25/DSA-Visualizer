# DSA Visualizer Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Backend Configuration
# ============================================

# Node environment (development, production, test)
NODE_ENV=development

# API server port
PORT=4000

# Docker settings for executor communication
# The executor container name for Docker API communication
EXECUTOR_SERVICE_NAME=dsa-executor

# Docker network name (backend uses this to locate executor)
EXECUTOR_NETWORK=dsa-network

# ============================================
# Frontend Configuration
# ============================================

# Vite dev server port (default: 3000)
VITE_PORT=3000

# Backend API URL (frontend uses this to make API calls)
VITE_API_URL=http://localhost:4000

# ============================================
# Security Settings
# ============================================

# Maximum execution time for code (seconds)
MAX_EXECUTION_TIME=30

# Maximum memory for executor container (MB)
EXECUTOR_MEMORY_LIMIT=512

# Maximum steps to capture in execution trace
MAX_TRACE_STEPS=1000

# ============================================
# Optional: External Services
# ============================================

# LeetCode API (for fetching problems)
# LEETCODE_API_URL=https://leetcode.com/api

# OpenAI API (optional, for AI-powered hints)
# OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Development Settings
# ============================================

# Enable hot reload for backend (default: true)
ENABLE_HOT_RELOAD=true

# Log level (debug, info, warn, error)
LOG_LEVEL=info